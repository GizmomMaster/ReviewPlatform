{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "review-platform",
    "Audience": "review-platform",
    "SigningKey": ""
  },
  "Auth": {
    "SecureCookies": true
  },
  "FrontendBaseUrl": "http://localhost:8080",
  "Email": {
    "FromAddress": "no-reply@review.local",
    "FromName": "360 Review",
    "TimeZone": "Europe/Moscow"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "StartTlsWhenAvailable"
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalSeconds": 10,
    "BatchSize": 20,
    "MaxAttempts": 8
  },
  "Scheduler": {
    "Enabled": true,
    "IntervalSeconds": 60
  },
  "AssessmentPolicy": {
    "ReminderDaysBeforeDeadline": [
      3,
      1
    ]
  }
}
