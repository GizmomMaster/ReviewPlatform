# Пример настроек: скопируйте в .env и укажите свои значения. Файл .env не коммитится.

# --- Разработка (docker-compose.yml) ---
POSTGRES_DB=reviewplatform
POSTGRES_USER=reviewplatform
POSTGRES_PASSWORD=reviewplatform

FRONTEND_PORT=18080       # приложение
BACKEND_PORT=15080        # API, Swagger UI
MAILPIT_UI_PORT=18025     # Mailpit, просмотр писем
MAILPIT_SMTP_PORT=11025   # Mailpit, SMTP
POSTGRES_PORT=25432       # PostgreSQL

# FRONTEND_BASE_URL=http://localhost:18080   # адрес приложения в письмах; по умолчанию http://localhost:<FRONTEND_PORT>

# --- Продакшен (дополнительно docker-compose.prod.yml) ---
# FRONTEND_BASE_URL=https://review.example.com
# JWT_SIGNING_KEY=            # openssl rand -base64 48
# BOOTSTRAP_ADMIN_EMAIL=      # первый администратор, создаётся только в пустой БД
# BOOTSTRAP_ADMIN_PASSWORD=   # временный: при первом входе система попросит сменить
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=StartTls      # None | Auto | SslOnConnect | StartTls | StartTlsWhenAvailable
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM_ADDRESS=review@example.com
# EMAIL_FROM_NAME=360 Review
